OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o  # optional, default: gpt-4o
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20250414  # optional
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview  # optional
GEMINI_CLI_ENABLED=false  # set to true to enable Gemini CLI (requires: npm install -g @google/gemini-cli)
GEMINI_CLI_MODEL=  # optional, e.g. gemini-2.5-flash
GEMINI_CLI_PATH=gemini  # optional, path to gemini binary
OLLAMA_MODEL=llama3 # e.g. llama3, mistral
OLLAMA_HOST=http://localhost:11434 # optional

OLLAMA_CLOUD_MODEL=llama3 # e.g. llama3
OLLAMA_CLOUD_HOST=https://your-cloud-ollama.example.com
OLLAMA_CLOUD_AUTH=optional_bearer_token
